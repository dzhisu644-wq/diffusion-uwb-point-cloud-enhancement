# Configuration used for the final eight-frame experiments.
# Environment variables supplied by the caller take precedence.
GLOBAL_BATCH="${GLOBAL_BATCH:-32}"
EDM_MICROBATCH="${EDM_MICROBATCH:-32}"
CD_MICROBATCH="${CD_MICROBATCH:-32}"
NUM_WORKERS="${NUM_WORKERS:-2}"
PREFETCH_FACTOR="${PREFETCH_FACTOR:-2}"
CACHE_IMAGES="${CACHE_IMAGES:-True}"
FAST_IO="${FAST_IO:-True}"
PIN_MEMORY="${PIN_MEMORY:-True}"
PERSISTENT_WORKERS="${PERSISTENT_WORKERS:-True}"
USE_FP16="${USE_FP16:-False}"
ALLOW_TF32="${ALLOW_TF32:-True}"
CUDNN_BENCHMARK="${CUDNN_BENCHMARK:-True}"

NUM_PAST_FRAMES="${NUM_PAST_FRAMES:-7}"
SEED="${SEED:-0}"
EDM_STEPS="${EDM_STEPS:-160000}"
CD_STEPS="${CD_STEPS:-120000}"
SAVE_INTERVAL="${SAVE_INTERVAL:-10000}"
EDM_LR="${EDM_LR:-0.00005}"
CD_LR="${CD_LR:-0.00005}"
EDM_TEACHER_EMA="${EDM_TEACHER_EMA:-0.9999}"

GPU_INDEX="${GPU_INDEX:-0}"
DATASET_DIR="${DATASET_DIR:-$BUNDLE_ROOT/X7_A1_dataset}"
SPLIT_MANIFEST="${SPLIT_MANIFEST:-$BUNDLE_ROOT/config/paper_train.csv}"
RUNS_DIR="${RUNS_DIR:-$BUNDLE_ROOT/runs}"
PYTHON_BIN="${PYTHON_BIN:-python3}"

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-2}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-2}"
export PYTHONHASHSEED="$SEED"

